<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Job</title>
  <link rel="stylesheet" href="/styles/style.css">
</head>

<body>
  <h1>Add a Job Posting</h1>

  <form id="jobForm" action="/submit-job" method="POST" class="job-form" novalidate onsubmit="return validateForm()">
    <label for="jobTitle">Job Title</label>
    <input type="text" id="jobTitle" name="jobTitle">
    <span class="error" id="jobTitleError"></span>

    <label for="companyName">Company Name</label>
    <input type="text" id="companyName" name="companyName">
    <span class="error" id="companyNameError"></span>

    <label for="tradeArea">Trade Area</label>
    <select id="tradeArea" name="tradeArea">
      <option value="">Choose one</option>
      <option value="Welding">Welding</option>
      <option value="Automotive">Automotive</option>
      <option value="Manufacturing">Manufacturing</option>
      <option value="Carpentry">Carpentry</option>
      <option value="Mechatronics">Mechatronics</option>
    </select>
    <span class="error" id="tradeAreaError"></span>

    <label for="location">Location</label>
    <input type="text" id="location" name="location">
    <span class="error" id="locationError"></span>

    <label for="jobType">Part or Full Time</label>
    <select id="jobType" name="jobType">
      <option value="">Choose one</option>
      <option value="Part Time">Part Time</option>
      <option value="Full Time">Full Time</option>
    </select>
    <span class="error" id="jobTypeError"></span>

    <label for="postDate">Post Date</label>
    <input type="date" id="postDate" name="postDate">
    <span class="error" id="postDateError"></span>

    <label for="expirationDate">Expiration Date</label>
    <input type="date" id="expirationDate" name="expirationDate">
    <span class="error" id="expirationDateError"></span>

    <label for="applicationUrl">Application URL</label>
    <input type="text" id="applicationUrl" name="applicationUrl">
    <span class="error" id="applicationUrlError"></span>

    <button type="submit">Submit Job</button>
  </form>

  <script src="/scripts/grc-trades-board.js"></script>
</body>

</html>