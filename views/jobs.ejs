<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head',{title: 'Browse Jobs' })%>
</head>
<body>
  <h1>Jobs</h1>

  <table class="jobs-table">
    <thead>
      <tr>
        <th>Job Title</th>
        <th>Company</th>
        <th>Trade Area</th>
        <th>Location</th>
        <th>Apply</th>
      </tr>
    </thead>
    <tbody>
      <% jobs.forEach(job => { %>
        <tr>
          <td><%= job.jobTitle %></td>
          <td><%= job.companyName %></td>
          <td><%= job.tradeArea %></td>
          <td><%= job.location %></td>
          <td>
            <a href="<%= job.applicationUrl %>" target="_blank" rel="noopener noreferrer">Apply Now</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>