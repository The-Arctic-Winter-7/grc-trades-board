<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head',{title: 'Browse Jobs' })%>
  <!-- DataTables CSS CDN -->
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css">
</head>

<body>
  <%- include('partials/nav', { heading: 'Dashboard' })%>
  <div id="main">
    <h1>Browse Available Jobs</h1>
    <div id="main-button-container" .=>
      <a href="/" class="main-button">Back home</a>
      <a href="/add-job" class="main-button">Add a Job </a>
      <a href="https://www.greenriver.edu/students/academics/areas-of-interest/program-maps/trades-industrial-tech-aviation-natural-resources/index.html" target="_blank" rel="noopener noreferrer" class="main-button">Explore GRC Trades Programs</a>
    </div>

    <% if (jobs.length===0) { %>
    <p> No jobs are currently available. Check back later or add a new job posting!</p>
    <% } else { %>
    <table class="jobs-table">
      <thead>
        <tr>
          <th>Job Title</th>
          <th>Company</th>
          <th>Trade Area</th>
          <th>Location</th>
          <th>Job or Internship</th>
          <th>Full-Time or Part-Time</th>
          <th>Expiration Date</th>
          <th>Apply</th>
        </tr>
      </thead>
      <tbody>
        <% jobs.forEach(job=> { %>
        <tr>
          <td>
            <%= job.job_title %>
          </td>
          <td>
            <%= job.company_name %>
          </td>
          <td>
            <%= job.trade_area %>
          </td>
          <td>
            <%= job.location %>
          </td>
          <td>
            <%= job.listing_type %>
          </td>
          <td>
            <%= job.job_type %>
          </td>
          <td data-order = "<%= job.expiration_date.toISOString() %>">
            <%= job.expiration_date.toLocaleDateString('en-US') %>
          </td>
          <td>
            <a href="<%= job.application_url %>" target="_blank" rel="noopener noreferrer" class="main-button">Apply Now</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>

  <!-- JQuery CDN-->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <!-- DataTables JS CDN -->
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

  <!-- Initialize DataTables -->
  <script>
    $(document).ready(function() {
      $('.jobs-table').DataTable({
        responsive: {
          details: {
            display: $.fn.DataTable.Responsive.display.childRowImmediate
          }
        },
        "order":[[6, 'asc']], // Sorts by expiration date by default; first to expire is first
        columnDefs: [{
          orderable: false,
          targets: 7          // Refers to 'Apply' column of the table; apply column cannot be sorted
        }]
      });
    });
  </script>
</body>

</html>